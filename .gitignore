# Scan data. The full captures are the source the whole splat pipeline starts from, so they are
# tracked through Git LFS (see .gitattributes) rather than ignored. What stays out is everything
# derived from them: proxies regenerate with tools/spz_decimate.py, .rad sets with
# tools/build-rad.sh, and together they are ~486 MB of output nobody needs to clone.
data/splats/proxy/
data/splats/rad/

# The exporter copies the packaged clips into the Unity project. data/audio is the one tracked
# copy; this one is generated output, and duplicating 4.8 MB of LFS objects on every export
# would burn quota for nothing. Regenerate with the audio export step.
app/Assets/StreamingAssets/ShoalingUpstream/audio/
app/Assets/StreamingAssets/ShoalingUpstream/audio/
app/Assets/StreamingAssets/ShoalingUpstream/audio.meta

# Draft backups written by seed-journeys before it overwrites anything.
data/journeys/*/draft.*.bak.json

node_modules/
logs/
.DS_Store

# Unity
app/Library/
app/Temp/
app/Obj/
app/Build/
app/Builds/
app/Logs/
app/UserSettings/
app/MemoryCaptures/
app/Recordings/
*.csproj
*.sln
*.unityproj
app/Assets/**/*.pdb

# Local standalone exports, audits and Unity recovery files
builds/
validation/
standalone-source.patch
app/Assets/_Recovery/
app/Assets/_Recovery.meta
app/mono_crash*
